  "payloadContracts": {
    "assistant.delta": {
      "required": ["text"],
      "properties": { "text": "string" }
    },
    "assistant.thinking.delta": {
      "required": ["text"],
      "properties": { "text": "string" }
    },
    "assistant.supersedes": {
      "required": ["supersedes"],
      "properties": { "supersedes": "string" }
    },
    "assistant.final": {
      "required": ["assistant"],
      "properties": { "assistant": "string" }
    },
    "tool.started": {
      "required": ["id", "name"],
      "properties": { "id": "string", "name": "string", "input": "object" }
    },
    "tool.done": {
      "required": ["id", "status"],
      "properties": { "id": "string", "status": "string" }
    },
    "task.created": {
      "required": ["taskRun"],
      "properties": { "taskRun": "object" }
    },
    "task.plan.updated": {
      "required": ["taskRunId", "plan"],
      "properties": { "taskRunId": "string", "plan": "array" }
    },
    "task.completed": {
      "required": ["taskRunId", "status", "completionStatus", "taskRun"],
      "properties": {
        "taskRunId": "string",
        "status": "string",
        "completionStatus": "string",
        "taskRun": "object"
      }
    },
    "turn.started": {
      "properties": { "text": "string" }
    },
    "turn.dispatch_outcome_unknown": {
      "required": ["status", "automaticReplay", "manualRecoveryRequired"],
      "properties": {
        "status": "string",
        "automaticReplay": "boolean",
        "manualRecoveryRequired": "boolean"
      }
    },
    "turn.dispatch_blocked": {
      "required": ["reason", "automaticReplay"],
      "properties": {
        "reason": "string",
        "automaticReplay": "boolean"
      }
    },
    "turn.completed": {
      "properties": { "assistant": "string", "toolsSummary": "object" }
    }
  },
  "taskRunFields": [
    "schemaVersion",
    "id",
    "agentGraphId",
