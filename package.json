{
  "name": "lily-workbench",
  "version": "0.1.4",
  "private": true,
  "description": "智能工作台桌面客户端",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "DEV_USE_SYSTEM_AGENT=1 electron .",
    "test:unit": "node scripts/test-turn-controller.mjs && node scripts/test-turn-boundary.mjs && node scripts/test-interrupt-and-send.mjs && node scripts/test-agent-runner.mjs && node scripts/test-agent-tool-lease.mjs && node scripts/test-license-update.mjs && node scripts/test-release-admin.mjs && node scripts/test-turn-auto-recovery.mjs && node scripts/test-turn-message-queue.mjs && node scripts/test-session-events.mjs && node scripts/test-runtime-python.mjs && node scripts/test-spawn-env-runtime.mjs && node scripts/test-locale-settings.mjs && node scripts/test-data-migration.mjs && node scripts/test-skill-root.mjs && node scripts/test-ship-ignore.mjs && node scripts/test-agent-guide-mirror.mjs && node scripts/test-vision-translator.mjs && node scripts/test-image-send-flow.mjs",
    "sync:skills-catalog": "node scripts/sync-skills-catalog.mjs",
    "sync:skills-bundle": "node scripts/sync-skills-catalog.mjs --bundle-only",
    "generate:skill-i18n": "node scripts/generate-skill-i18n.mjs",
    "license:keygen": "node scripts/license-keygen.mjs",
    "license:generate": "node scripts/generate-license.mjs",
    "updates:sign-manifest": "node scripts/sign-update-manifest.mjs",
    "release:admin": "node scripts/release-admin.mjs",
    "release:one": "node scripts/release-one-click.mjs",
    "release:all": "node scripts/release-one-click.mjs --target all --upload",
    "build:runtime": "node scripts/build-runtime-bundle.mjs",
    "verify:runtime": "node scripts/verify-runtime-bundle.mjs",
    "icon:optimize": "node scripts/optimize-icon.mjs",
    "rebuild:pty": "node scripts/rebuild-pty.mjs",
    "pack": "node scripts/purge-macos-junk.mjs && electron-builder --dir",
    "dist:win": "node scripts/verify-runtime-bundle.mjs --platform win32-x64 --allow-missing && node scripts/purge-macos-junk.mjs && bash scripts/dist-win.sh && node scripts/verify-win-pack.mjs",
    "dist:mac": "node scripts/verify-runtime-bundle.mjs && node scripts/purge-macos-junk.mjs && bash scripts/dist-mac.sh && node scripts/verify-mac-pack.mjs && node scripts/build-mac-dmg.mjs && node scripts/verify-mac-dmg.mjs",
    "purge:macos-junk": "node scripts/purge-macos-junk.mjs",
    "build:runtime:win": "node scripts/build-runtime-bundle.mjs --platform win32-x64",
    "dist:all": "bash -c 'source scripts/setup-proxy.sh && node scripts/verify-runtime-bundle.mjs && node scripts/ensure-win-runtime.mjs && node scripts/purge-macos-junk.mjs && npx electron-builder --mac --win --x64 && node scripts/build-mac-dmg.mjs --arch x64 && node scripts/verify-mac-dmg.mjs --arch x64 && node scripts/verify-win-pack.mjs'"
  },
  "build": {
    "appId": "com.company.ai-super-terminal",
    "productName": "Lily Workbench",
    "directories": {
      "buildResources": "resources"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!**/__MACOSX/**",
          "!**/.DS_Store",
          "!**/._*"
        ]
      }
    ],
    "files": [
      "src/**/*",
      "resources/**/*",
      "!**/__MACOSX/**",
      "!**/.DS_Store",
      "!**/._*",
      "package.json"
    ],
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools",
      "extraResources": [
        {
          "from": "bundles/darwin-arm64",
          "to": "bundles/darwin-arm64",
          "filter": [
            "**/*",
            "!**/__MACOSX/**",
            "!**/.DS_Store",
            "!**/._*"
          ]
        },
        {
          "from": "bundles/darwin-x64",
          "to": "bundles/darwin-x64",
          "filter": [
            "**/*",
            "!**/__MACOSX/**",
            "!**/.DS_Store",
            "!**/._*"
          ]
        }
      ],
      "target": [
        "zip",
        "dir"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "signIgnore": [
        ".*/Resources/bundles/.*"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "title": "${productName}-${version}",
      "format": "UDZO",
      "sign": false
    },
    "win": {
      "icon": "icon.png",
      "executableName": "LilyWorkbench",
      "extraResources": [
        {
          "from": "bundles/win32-x64",
          "to": "bundles/win32-x64",
          "filter": [
            "**/*",
            "!**/__MACOSX/**",
            "!**/.DS_Store",
            "!**/._*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lily Workbench",
      "unicode": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  },
  "dependencies": {
    "dompurify": "^3.4.5",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.4"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "sharp": "^0.34.5"
  }
}
