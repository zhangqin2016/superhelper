PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lily_workbench
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me
SESSION_SECRET=change-me-at-least-32-chars
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=
QINIU_PUBLIC_BASE_URL=https://qny.lanrensoft.cn
ALLOW_UNSIGNED_LICENSES=true
PUBLIC_BASE_URL=https://lily.lanrensoft.cn
MODEL_GATEWAY_ENABLED=true
MODEL_GATEWAY_TOKEN_SECRET=change-me-at-least-32-chars
MODEL_GATEWAY_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
LITELLM_BASE_URL=http://litellm:4000
LITELLM_API_KEY=
LOCAL_ANTHROPIC_BASE_URL=
LOCAL_ANTHROPIC_API_KEY=
LOCAL_ANTHROPIC_MODEL=local-qwen
# Character Worlds rollout policy (signed client config; conservative default off)
CHARACTER_WORLDS_ENABLED=false
CHARACTER_WORLDS_COMPATIBILITY_PROFILE=lily-character-compat-1
CHARACTER_WORLDS_MINIMUM_CLIENT_VERSION=0.1.145
# Collaboration Center rollout (disabled by default; never put KEKs in client config)
COLLABORATION_ENABLED=false
# Emergency fail-closed switch; it overrides every signed profile immediately.
COLLABORATION_KILL_SWITCH=false
COLLABORATION_REALTIME_ENABLED=true
COLLABORATION_ATTACHMENTS_ENABLED=false
COLLABORATION_WORKSPACE_SHARES_ENABLED=false
COLLABORATION_AI_TOOLS_ENABLED=false
COLLABORATION_ROLLOUT_ORGANIZATIONS=
COLLAB_MESSAGE_KEK=
COLLAB_MESSAGE_KEK_VERSION=v1
