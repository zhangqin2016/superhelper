HTTP_PORT=18080
API_PORT=13000
WEB_PORT=13001

# internal: compose 自带 Postgres
# external: 使用宝塔已有 Postgres，不启动 lily-db
DB_MODE=internal

# bundled: 启动 lily-gateway 容器统一入口
# external: 使用服务器已有宝塔/Nginx/gateway，不启动 lily-gateway
GATEWAY_MODE=bundled

POSTGRES_DB=lily_workbench
POSTGRES_USER=lily
POSTGRES_PASSWORD=change-this-database-password

# DB_MODE=external 时填写宝塔 PG 连接串。
# 如果容器连宿主机 PG，Mac/Windows Docker 可用 host.docker.internal；
# Linux 宝塔一般建议填宿主机内网 IP，或把 PG 监听放开给 Docker 网段。
DATABASE_URL=postgres://user:password@host:5432/lily_workbench

# GATEWAY_MODE=external 时，web 服务端访问 API 的公网或内网地址。
# 如果宝塔 Nginx 把 /api 反代到 API_PORT，建议填 https://你的域名。
PUBLIC_API_BASE_URL=http://127.0.0.1:13000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_TOKEN=change-this-admin-token
SESSION_SECRET=change-this-session-secret-at-least-32-chars

ALLOW_UNSIGNED_LICENSES=false
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

QINIU_PUBLIC_BASE_URL=https://qny.lanrensoft.cn
RELEASE_CDN_PREFIX=app/updates

# 可选：服务器无法访问 Docker Hub 时设置国内可访问的 Node 基础镜像。
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
