HTTP_PORT=18080
API_PORT=13000
WEB_PORT=13001

# internal: compose 自带 Postgres
# external: 使用宝塔已有 Postgres，不启动 lily-db
DB_MODE=internal

# bundled: 启动 lily-gateway 容器统一入口
# external: 使用服务器已有宝塔/Nginx/gateway，不启动 lily-gateway
GATEWAY_MODE=bundled

POSTGRES_DB=lily_workbench
POSTGRES_USER=lily
POSTGRES_PASSWORD=change-this-database-password

# DB_MODE=external 时填写宝塔 PG 连接串。
# 如果容器连宿主机 PG，Mac/Windows Docker 可用 host.docker.internal；
# Linux 宝塔一般建议填宿主机内网 IP，或把 PG 监听放开给 Docker 网段。
DATABASE_URL=postgres://user:password@host:5432/lily_workbench

# GATEWAY_MODE=external 时，web 服务端访问 API 的公网或内网地址。
# 如果宝塔 Nginx 把 /api 反代到 API_PORT，建议填 https://你的域名。
PUBLIC_API_BASE_URL=http://127.0.0.1:13000

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_TOKEN=change-this-admin-token
SESSION_SECRET=change-this-session-secret-at-least-32-chars
PUBLIC_BASE_URL=https://lily.lanrensoft.cn

ALLOW_UNSIGNED_LICENSES=false
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

QINIU_PUBLIC_BASE_URL=https://qny.lanrensoft.cn
RELEASE_CDN_PREFIX=app/updates

# 可选：服务器无法访问 Docker Hub 时设置国内可访问的 Node 基础镜像。
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine

# Model gateway / provider control plane.
MODEL_GATEWAY_ENABLED=true
MODEL_GATEWAY_TOKEN_SECRET=change-this-model-gateway-secret-at-least-32-chars
MODEL_GATEWAY_DEFAULT_PROVIDER=deepseek
# Chat model delivery: gateway is the product default. It keeps provider keys
# server-side and sends clients only short-lived Lily gateway tokens.
# Use direct only for private deployments that accept shipping provider keys.
MODEL_CONFIG_DELIVERY_MODE=gateway

# Released local capability. Set false only as an emergency rollout switch.
CHARACTER_WORLDS_ENABLED=true
CHARACTER_WORLDS_COMPATIBILITY_PROFILE=lily-character-compat-1
CHARACTER_WORLDS_MINIMUM_CLIENT_VERSION=0.1.145
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=

# 阿里百炼同时用于模型网关、图片生成、视频生成、语音合成技能。
# DASHSCOPE_BASE_URL 只用于 Claude/Anthropic-compatible 模型网关；
# 媒体技能如需自定义入口，请使用下面的专用 endpoint。
DASHSCOPE_MODEL=qwen3-coder-plus
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro
DASHSCOPE_VIDEO_MODEL=wan2.7-t2v
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanyang
DASHSCOPE_IMAGE_ENDPOINT=
DASHSCOPE_VIDEO_ENDPOINT=
DASHSCOPE_TTS_ENDPOINT=

# LiteLLM protocol layer. Set LITELLM_ENABLED=true and deploy with
# docker-compose.litellm.yml when you need to adapt self-hosted or
# OpenAI-compatible models to Claude/Anthropic-compatible endpoints.
LITELLM_ENABLED=false
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=change-this-litellm-master-key
LITELLM_API_KEY=change-this-litellm-master-key
LOCAL_OPENAI_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_OPENAI_API_KEY=local-dev-key
LOCAL_QWEN_MODEL=openai/local-qwen
LOCAL_QWEN_FAST_MODEL=openai/local-qwen-fast
LOCAL_QWEN_STRONG_MODEL=openai/local-qwen-strong

# If a customer self-hosts an Anthropic-compatible gateway directly, configure
# it here and choose the "Local Anthropic Gateway" preset in the admin console.
LOCAL_ANTHROPIC_BASE_URL=
LOCAL_ANTHROPIC_API_KEY=
LOCAL_ANTHROPIC_MODEL=local-qwen
