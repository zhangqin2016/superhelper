<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 JIT under the hardened runtime (required for notarization). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- We spawn the claude CLI and a bundled Python runtime with a custom env. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Load the bundled Python/runtime dylibs that aren't signed by us. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Voice dictation captures microphone audio under the hardened runtime. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
